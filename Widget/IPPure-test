// =============================================
// Egern IPPure Widget — Stripe Edition
// Design: Stripe-inspired dark canvas
// - Deep navy gradient background
// - Electric indigo (#533afd) accent
// - Pill-shaped tags with translucent indigo
// - Clean, airy, financial-instrument precision
// Risk tiers: IPPure official 6-tier (2026)
// =============================================

export default async function(ctx) {

  const strategyGroup =
    ctx.env.STRATEGY_GROUP || 'DIRECT';

  const widgetFamily =
    ctx.widgetFamily || 'systemLarge';

  // ==================== Stripe-Inspired Palette ====================

  const C = {
    // Deep navy gradient — Stripe dashboard DNA
    bgTop: '#0F172A',
    bgBottom: '#1E293B',

    // Electric indigo — Stripe's signature accent
    primary: '#533afd',
    primarySoft: 'rgba(83, 58, 253, 0.12)',
    primaryMedium: 'rgba(83, 58, 253, 0.2)',

    // Borders & surfaces
    borderColor: 'rgba(83, 58, 253, 0.15)',
    borderStrong: 'rgba(83, 58, 253, 0.25)',

    // Text — clean, airy, high readability
    text: '#F1F5F9',
    secondary: '#94A3B8',
    muted: '#64748B',

    // IPPure 6-tier risk colors (softened for Stripe refinement)
    risk0: '#10B981',   // 0-15  极度纯净
    risk1: '#34D399',   // 15-25 纯净
    risk2: '#84CC16',   // 25-40 中性
    risk3: '#FBBF24',   // 40-50 轻度风险
    risk4: '#FB923C',   // 50-70 中度风险
    risk5: '#F87171',   // 70-100 极度风险

    // Network type
    residential: '#34D399',
    datacenter: '#FBBF24',
  };

  // Vertical subtle gradient
  const stripeGradient = {
    type: 'linear',
    colors: [C.bgTop, C.bgBottom],
    startPoint: { x: 0.5, y: 0 },
    endPoint: { x: 0.5, y: 1 }
  };

  // ==================== Fetch ====================

  let data = null;

  try {
    const resp = await ctx.http.get(
      'https://my.ippure.com/v1/info',
      {
        policy: strategyGroup,
        timeout: 8000
      }
    );
    data = await resp.json();
  } catch(e) {}

  // ==================== Fallback ====================

  if (!data) {
    data = {
      ip: '请求失败',
      asn: '---',
      asOrganization: 'Network Error',
      country: 'Unknown',
      region: '',
      city: '',
      fraudScore: 99,
      isResidential: false
    };
  }

  // ==================== Risk & Colors (IPPure 6-tier) ====================

  const riskScore = Number(data.fraudScore || 0);

  let riskText = '极度风险';
  let riskColor = C.risk5;

  if (riskScore <= 15) {
    riskText = '极度纯净';
    riskColor = C.risk0;
  } else if (riskScore <= 25) {
    riskText = '纯净';
    riskColor = C.risk1;
  } else if (riskScore <= 40) {
    riskText = '中性';
    riskColor = C.risk2;
  } else if (riskScore <= 50) {
    riskText = '轻度风险';
    riskColor = C.risk3;
  } else if (riskScore <= 70) {
    riskText = '中度风险';
    riskColor = C.risk4;
  }

  // ==================== Network ====================

  const networkText =
    data.isResidential === true
      ? '住宅原生'
      : '机房网络';

  const networkColor =
    data.isResidential === true
      ? C.residential
      : C.datacenter;

  // ==================== Location ====================

  const locationText = [
    data.country,
    data.region,
    data.city
  ]
  .filter(Boolean)
  .join(' · ');

  const shortLocation = [
    data.country,
    data.city
  ]
  .filter(Boolean)
  .join(' · ');

  // ==================== Helpers ====================

  // Stripe-style pill badge with translucent background
  function stripePill(text, color) {
    return {
      type: 'stack',
      direction: 'row',
      gap: 5,
      backgroundColor: color + '20',
      borderRadius: 9999,
      padding: [2, 8],
      children: [
        {
          type: 'image',
          src: 'sf-symbol:circle.fill',
          width: 6,
          height: 6,
          color: color
        },
        {
          type: 'text',
          text: text,
          font: { size: 'caption2', weight: 'semibold' },
          textColor: color
        }
      ]
    };
  }

  // Stripe-style data row (label · value)
  function dataRow(label, value, valueColor) {
    return {
      type: 'stack',
      direction: 'row',
      children: [
        {
          type: 'text',
          text: label,
          font: { size: 'caption1', weight: 'regular' },
          textColor: C.muted
        },
        {
          type: 'spacer'
        },
        {
          type: 'text',
          text: value,
          font: { size: 'caption1', weight: 'medium' },
          textColor: valueColor || C.secondary
        }
      ]
    };
  }

  // Hairline divider
  function divider() {
    return {
      type: 'stack',
      height: 1,
      backgroundColor: C.borderColor
    };
  }

  // ============================================
  // ACCESSORY CIRCULAR (Lock screen — small circle)
  // ============================================

  if (widgetFamily === 'accessoryCircular') {

    return {
      type: 'widget',
      children: [
        {
          type: 'stack',
          direction: 'column',
          gap: 2,
          children: [
            {
              type: 'text',
              text: String(riskScore),
              font: { size: 20, weight: 'bold' },
              textColor: riskColor,
              textAlign: 'center'
            },
            {
              type: 'text',
              text: riskText,
              font: { size: 'caption2', weight: 'medium' },
              textColor: riskColor,
              textAlign: 'center'
            }
          ]
        }
      ]
    };

  }

  // ============================================
  // ACCESSORY RECTANGULAR (Lock screen — wider)
  // ============================================

  if (widgetFamily === 'accessoryRectangular') {

    return {
      type: 'widget',
      padding: 12,
      gap: 6,
      children: [
        {
          type: 'stack',
          direction: 'row',
          gap: 6,
          children: [
            {
              type: 'image',
              src: 'sf-symbol:shield.fill',
              width: 12,
              height: 12,
              color: C.primary
            },
            {
              type: 'text',
              text: data.ip || 'N/A',
              font: { size: 'subheadline', weight: 'semibold' },
              textColor: C.text
            }
          ]
        },
        {
          type: 'stack',
          direction: 'row',
          gap: 8,
          children: [
            stripePill(networkText, networkColor),
            {
              type: 'text',
              text: riskText,
              font: { size: 'caption2', weight: 'semibold' },
              textColor: riskColor
            }
          ]
        }
      ]
    };

  }

  // ============================================
  // SYSTEM SMALL
  // ============================================

  if (widgetFamily === 'systemSmall') {

    return {
      type: 'widget',
      backgroundGradient: stripeGradient,
      padding: 16,
      gap: 10,
      children: [

        // Header — strategy group as indigo pill
        {
          type: 'stack',
          direction: 'row',
          children: [
            {
              type: 'stack',
              direction: 'row',
              gap: 6,
              backgroundColor: C.primarySoft,
              borderRadius: 9999,
              padding: [3, 8],
              children: [
                {
                  type: 'image',
                  src: 'sf-symbol:circle.fill',
                  width: 7,
                  height: 7,
                  color: C.primary
                },
                {
                  type: 'text',
                  text: strategyGroup,
                  font: { size: 'caption2', weight: 'semibold' },
                  textColor: C.primary
                }
              ]
            }
          ]
        },

        // Country
        {
          type: 'text',
          text: data.country || 'Unknown',
          font: { size: 15, weight: 'semibold' },
          textColor: C.text
        },

        // Network type pill
        stripePill(networkText, networkColor),

        { type: 'spacer' },

        // Risk score — large hero number
        {
          type: 'stack',
          direction: 'row',
          gap: 8,
          children: [
            {
              type: 'text',
              text: String(riskScore),
              font: { size: 30, weight: 'bold' },
              textColor: riskColor
            },
            {
              type: 'stack',
              children: [
                { type: 'spacer' },
                {
                  type: 'text',
                  text: riskText,
                  font: { size: 'caption1', weight: 'semibold' },
                  textColor: riskColor
                }
              ]
            }
          ]
        }
      ]
    };

  }

  // ============================================
  // SYSTEM MEDIUM
  // ============================================

  if (widgetFamily === 'systemMedium') {

    return {
      type: 'widget',
      backgroundGradient: stripeGradient,
      padding: 18,
      gap: 10,
      children: [

        // Header — brand + strategy
        {
          type: 'stack',
          direction: 'row',
          children: [
            {
              type: 'stack',
              direction: 'row',
              gap: 8,
              children: [
                {
                  type: 'image',
                  src: 'sf-symbol:shield.fill',
                  width: 16,
                  height: 16,
                  color: C.primary
                },
                {
                  type: 'text',
                  text: 'IPPure',
                  font: { size: 'headline', weight: 'semibold' },
                  textColor: C.text
                }
              ]
            },
            {
              type: 'spacer'
            },
            {
              type: 'stack',
              backgroundColor: C.primarySoft,
              borderRadius: 9999,
              padding: [2, 8],
              children: [
                {
                  type: 'text',
                  text: strategyGroup,
                  font: { size: 'caption2', weight: 'semibold' },
                  textColor: C.primary
                }
              ]
            }
          ]
        },

        // IP address
        {
          type: 'text',
          text: data.ip || 'N/A',
          font: { size: 24, weight: 'bold' },
          textColor: C.text
        },

        // Status pills row
        {
          type: 'stack',
          direction: 'row',
          gap: 10,
          children: [
            stripePill(networkText, networkColor),
            stripePill(riskText, riskColor)
          ]
        },

        { type: 'spacer' },

        // Bottom row — location + risk score
        {
          type: 'stack',
          direction: 'row',
          children: [
            {
              type: 'text',
              text: shortLocation || 'Unknown',
              font: { size: 'subheadline' },
              textColor: C.secondary
            },
            {
              type: 'spacer'
            },
            {
              type: 'text',
              text: String(riskScore),
              font: { size: 'title3', weight: 'bold' },
              textColor: riskColor
            }
          ]
        }
      ]
    };

  }

  // ============================================
  // SYSTEM EXTRA LARGE (iPad)
  // ============================================

  if (widgetFamily === 'systemExtraLarge') {

    return {
      type: 'widget',
      backgroundGradient: stripeGradient,
      padding: 22,
      gap: 14,
      children: [

        // Header
        {
          type: 'stack',
          direction: 'row',
          children: [
            {
              type: 'stack',
              direction: 'row',
              gap: 8,
              children: [
                {
                  type: 'image',
                  src: 'sf-symbol:shield.fill',
                  width: 20,
                  height: 20,
                  color: C.primary
                },
                {
                  type: 'text',
                  text: 'IPPure',
                  font: { size: 'headline', weight: 'semibold' },
                  textColor: C.text
                }
              ]
            },
            {
              type: 'spacer'
            },
            {
              type: 'stack',
              backgroundColor: C.primarySoft,
              borderRadius: 9999,
              padding: [2, 10],
              children: [
                {
                  type: 'text',
                  text: strategyGroup,
                  font: { size: 'caption1', weight: 'semibold' },
                  textColor: C.primary
                }
              ]
            }
          ]
        },

        // Section label
        {
          type: 'text',
          text: 'CURRENT IP',
          font: { size: 'caption1', weight: 'medium' },
          textColor: C.muted
        },

        // IP
        {
          type: 'text',
          text: data.ip || 'N/A',
          font: { size: 36, weight: 'bold' },
          textColor: C.text
        },

        // Status pills
        {
          type: 'stack',
          direction: 'row',
          gap: 14,
          children: [
            stripePill(networkText, networkColor),
            stripePill(riskText, riskColor)
          ]
        },

        divider(),

        // Details
        dataRow('位置', locationText || 'Unknown'),
        dataRow('运营商', data.asOrganization || 'Unknown'),
        dataRow('ASN', String(data.asn || '---')),
        dataRow('广播IP', data.isBroadcast === true ? '是' : '否'),
        dataRow('风险系数', String(riskScore), riskColor),

        { type: 'spacer' },

        // Footer
        {
          type: 'stack',
          direction: 'row',
          gap: 6,
          children: [
            {
              type: 'image',
              src: 'sf-symbol:checkmark.circle.fill',
              width: 12,
              height: 12,
              color: C.primary
            },
            {
              type: 'text',
              text: 'Connection Active',
              font: { size: 'caption2' },
              textColor: C.secondary
            }
          ]
        }
      ]
    };

  }

  // ============================================
  // SYSTEM LARGE (default)
  // ============================================

  return {
    type: 'widget',
    backgroundGradient: stripeGradient,
    padding: 20,
    gap: 12,
    children: [

      // Header — brand + strategy pill
      {
        type: 'stack',
        direction: 'row',
        children: [
          {
            type: 'stack',
            direction: 'row',
            gap: 8,
            children: [
              {
                type: 'image',
                src: 'sf-symbol:shield.fill',
                width: 18,
                height: 18,
                color: C.primary
              },
              {
                type: 'text',
                text: 'IPPure',
                font: { size: 'headline', weight: 'semibold' },
                textColor: C.text
              }
            ]
          },
          {
            type: 'spacer'
          },
          {
            type: 'stack',
            backgroundColor: C.primarySoft,
            borderRadius: 9999,
            padding: [2, 10],
            children: [
              {
                type: 'text',
                text: strategyGroup,
                font: { size: 'caption2', weight: 'semibold' },
                textColor: C.primary
              }
            ]
          }
        ]
      },

      // Section label
      {
        type: 'text',
        text: 'CURRENT IP',
        font: { size: 'caption1', weight: 'medium' },
        textColor: C.muted
      },

      // IP
      {
        type: 'text',
        text: data.ip || 'N/A',
        font: { size: 32, weight: 'bold' },
        textColor: C.text
      },

      // Status pills
      {
        type: 'stack',
        direction: 'row',
        gap: 14,
        children: [
          stripePill(networkText, networkColor),
          stripePill(riskText, riskColor)
        ]
      },

      divider(),

      // Details
      dataRow('位置', locationText || 'Unknown'),
      dataRow('运营商', data.asOrganization || 'Unknown'),
      dataRow('广播IP', data.isBroadcast === true ? '是' : '否'),
      dataRow('风险系数', String(riskScore), riskColor),

      { type: 'spacer' },

      // Footer
      {
        type: 'stack',
        direction: 'row',
        gap: 6,
        children: [
          {
            type: 'image',
            src: 'sf-symbol:checkmark.circle.fill',
            width: 12,
            height: 12,
            color: C.primary
          },
          {
            type: 'text',
            text: 'Connection Active',
            font: { size: 'caption2' },
            textColor: C.secondary
          }
        ]
      }
    ]
  };

}
